{
  "datasets": [
    {
      "catalog": "formula1",
      "displayName": "Seasonal Formula One Driver Performance Summary",
      "name": "1fbaee87",
      "queryLines": [
        "\r\n",
        "WITH resumen_piloto AS (\r\n",
        "  SELECT\r\n",
        "    r.temporada,\r\n",
        "    d.id_piloto,\r\n",
        "    d.nombre_piloto,\r\n",
        "    d.nacionalidad,\r\n",
        "    COUNT(*) AS numero_carreras,\r\n",
        "    SUM(r.puntos) AS puntos_totales,\r\n",
        "    COUNT_IF(r.is_win) AS numero_de_victorias,\r\n",
        "    COUNT_IF(r.is_podium) AS numero_de_podiums\r\n",
        "  FROM\r\n",
        "    formula1.gold.fact_resultado_sesion r\r\n",
        "      JOIN formula1.gold.dim_piloto d\r\n",
        "        ON r.id_piloto = d.id_piloto\r\n",
        "  GROUP BY\r\n",
        "    r.temporada,\r\n",
        "    d.id_piloto,\r\n",
        "    d.nombre_piloto,\r\n",
        "    d.nacionalidad\r\n",
        "),\r\n",
        "resumen as (\r\n",
        "SELECT\r\n",
        "  temporada,\r\n",
        "  id_piloto,\r\n",
        "  nombre_piloto,\r\n",
        "  nacionalidad,\r\n",
        "  RANK() OVER (PARTITION BY temporada ORDER BY puntos_totales DESC, numero_de_victorias DESC) AS standing,\r\n",
        "  numero_carreras,\r\n",
        "  puntos_totales,\r\n",
        "  numero_de_victorias,\r\n",
        "  numero_de_podiums\r\n",
        "FROM\r\n",
        "  resumen_piloto),\r\n",
        "metricas_piloto as (\r\n",
        "select \r\n",
        "nombre_piloto,\r\n",
        "sum(numero_carreras) as numero_carrreas,\r\n",
        "sum(numero_de_podiums) as total_podiums,\r\n",
        "sum(numero_de_victorias) as total_victorias,\r\n",
        "sum (case when standing = 1 then 1 else 0 end) as total_campeonatos\r\n",
        "from \r\n",
        "resumen\r\n",
        "group by nombre_piloto\r\n",
        "having total_campeonatos >= 1 )\r\n",
        "select\r\n",
        "nombre_piloto,\r\n",
        "numero_carrreas,\r\n",
        "total_podiums,\r\n",
        "total_victorias,\r\n",
        "total_campeonatos ,\r\n",
        "(total_campeonatos * 100)+ (total_victorias *10) + (total_victorias* 3) as puntaje_relevante\r\n",
        "from  metricas_piloto\r\n",
        "order by puntaje_relevante desc\r\n",
        "limit 10;"
      ],
      "schema": "gold"
    }
  ],
