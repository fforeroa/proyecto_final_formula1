{
  "datasets": [
    {
      "catalog": "formula1",
      "displayName": "Montoya",
      "name": "bf72d966",
      "queryLines": [
        "select \r\n",
        "a.estado,\r\n",
        "a.posicion_final_texto,\r\n",
        "a.posicion_final,\r\n",
        "a.posicion_grilla,\r\n",
        "a.puntos,\r\n",
        "case when a.is_win=true then 1 else 0 end as  is_win,\r\n",
        "case when a.is_podium=true then 1 else 0 end as is_podium,\r\n",
        "case when a.estado ='Finalizado' then 'Finalizado' else 'No Finalizado' end as carreras_finalizadas,\r\n",
        "a.has_points,\r\n",
        "b.nombre_piloto,\r\n",
        "c.nombre_constrcutor,\r\n",
        "d.nombre_carrera,\r\n",
        "d.nombre_circuito,\r\n",
        "a.temporada\r\n",
        "from\r\n",
        "gold.fact_resultado_sesion a\r\n",
        "join\r\n",
        "gold.dim_piloto b on a.id_piloto=b.id_piloto\r\n",
        "join gold.dim_constructor c on a.id_constructor=c.id_constructor\r\n",
        "join gold.dim_carrera d on a.temporada=d.temporada and a.numero_carrera= d.numero_carrera\r\n",
        "join gold.dim_constructor e on a.id_constructor=e.id_constructor\r\n",
        "where b.nombre_piloto='Juan Pablo Montoya'\r\n"
      ],
      "schema": "default"
    }
  ],
